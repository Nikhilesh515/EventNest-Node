NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/eventnest
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/eventnest_test
REDIS_URL=
CACHE_TTL_MINUTES=5
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ISSUER=EventNest.AuthService
JWT_AUDIENCE=EventNest
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=100
LOG_LEVEL=info
OPENAPI_ENABLED=false
